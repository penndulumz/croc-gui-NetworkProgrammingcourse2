{
  "name": "crocflow-desktop",
  "version": "1.0.0",
  "description": "CrocFlow Desktop — Trình truyền tệp mã hóa E2E đa nền tảng kèm Embedded Bridge & Dual-Relay Lab",
  "main": "main.mjs",
  "private": true,
  "scripts": {
    "bundle:server": "node scripts/bundle-server.mjs",
    "start": "npm run bundle:server && electron .",
    "dist:win": "npm run bundle:server && electron-builder --win",
    "dist:mac": "npm run bundle:server && electron-builder --mac",
    "dist:linux": "npm run bundle:server && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "app.crocflow.desktop",
    "productName": "CrocFlow",
    "directories": {
      "output": "../../release/desktop"
    },
    "files": [
      "main.mjs",
      "preload.mjs",
      "server.mjs",
      "dist/**/*"
    ],
    "asarUnpack": [
      "server.mjs",
      "dist/**/*"
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "mac": {
      "target": ["dmg"]
    },
    "linux": {
      "target": ["AppImage"]
    }
  }
}
